{
  "compilerOptions": {
    // Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Runtime target
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",

    // Types/runtime
    "types": ["node"],
    "lib": ["es2020"],
    "esModuleInterop": true,

    // Outputs (you can turn declaration back on if you actually need .d.ts)
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,

    // Strictness & misc
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": true,

    // Important: allow TS to transform import/export to CJS
    "verbatimModuleSyntax": false,

    // Keep simple to avoid ESM-only checks during dev
    "isolatedModules": false,
    "moduleDetection": "force"
  },
  "include": ["src"]
}
